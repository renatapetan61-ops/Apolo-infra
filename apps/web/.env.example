# Neon Postgres connection string
DATABASE_URL=

# Shared secret: generate a random 32+ byte value; configure the same value
# in Vercel (APOLO_WORKER_TOKEN) and Codespaces secret (APOLO_WORKER_TOKEN).
APOLO_WORKER_TOKEN=

# Clerk authentication (from the Clerk dashboard)
# CLERK_PUBLISHABLE_KEY is read by the server and passed to ClerkProvider.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Codespaces worker
APOLO_CONTROL_URL=https://YOUR-VERCEL-DOMAIN